DB_HOST=localhost
DB_PORT=5434
DB_NAME=thought_translate
DB_USER=tt_user
DB_PASSWORD=tt_password

REDIS_URL=redis://localhost:6380/0

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# First user created automatically on startup if no users exist yet.
BOOTSTRAP_ADMIN_EMAIL=admin@thoughttranslate.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

OAUTH_REDIRECT_BASE_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5174

# Optional — leave blank to disable a given provider (signup/login by
# email+password always works regardless).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Gemini via Vertex AI (en + Hindi). Needs a GCP project with Vertex AI
# enabled + active billing, and either GOOGLE_APPLICATION_CREDENTIALS
# pointing at a service-account JSON key (role: Vertex AI User), or run
# `gcloud auth application-default login` locally instead of setting this.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_SMART_MODEL=gemini-2.5-flash

# Sarvam AI (Indian languages other than Hindi)
SARVAM_API_KEY=
SARVAM_FAST_MODEL=sarvam-30b
SARVAM_SMART_MODEL=sarvam-105b

CORS_ORIGINS=http://localhost:5174

DEPLOYMENT_ENV=development
LOG_LEVEL=INFO
